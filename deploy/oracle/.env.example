# Copie este arquivo para .env somente na VM Oracle. Nunca versione segredos.
# Banco de dados de usuario/auth (continua no Supabase - favoritos, perfil, avaliacoes, etc; e
# o que o Supabase Auth usa direto, com cascade delete de auth.users intacto).
DATABASE_URL=postgresql://postgres:senha@host:5432/postgres
# Banco de catalogo (games/game_details/game_achievements/offers/price_history/
# instant_gaming_catalog) - roda local na propria VM (container catalogo-db do compose.yml),
# sem cota de armazenamento, so o disco da VM. Nao tem FK com usuario nenhum.
CATALOG_DATABASE_URL=postgresql://catalogo:senha@catalogo-db:5432/catalogo
CATALOGO_DB_PASSWORD=substitua
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=substitua
ITAD_API_KEY=substitua
STEAM_WEB_API_KEY=substitua
XBL_APP_KEY=substitua
SYNC_SECRET_KEY=substitua
APP_SYNC_SCHEDULER_ENABLED=true
APP_SYNC_SCHEDULER_PRICE_DELAY_MS=600000
APP_SYNC_SCHEDULER_STEAM_DELAY_MS=900000
APP_SYNC_SCHEDULER_STEAM_ACHIEVEMENTS_DELAY_MS=1800000
CORS_ALLOWED_ORIGINS=https://ofertagames.vercel.app,http://localhost:4200
FRONTEND_URL=https://ofertagames.vercel.app
# Dominio HTTPS da API. Pode usar temporariamente api.163.176.220.243.sslip.io.
API_DOMAIN=api.seu-dominio.com.br
# Use a URL HTTPS configurada em API_DOMAIN.
PUBLIC_BACKEND_URL=https://api.seu-dominio.com.br
