{
  "buildCommand": "ng build && rm -f dist/frontend/browser/index.csr.html",
  "outputDirectory": "dist/frontend/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/frontend/server/**"
    }
  },
  "headers": [
    {
      "source": "/(main|polyfills|styles|chunk)-([A-Z0-9]{8}).(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
