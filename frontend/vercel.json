{
  "buildCommand": "ng build",
  "outputDirectory": "dist/frontend/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/frontend/server/**"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
